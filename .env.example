# Private Key ของกระเป๋าสำหรับ Deploy (เช่น กระเป๋า Metamask ทดสอบ)
# คำเตือน: ใช้กระเป๋าสำหรับทดสอบเท่านั้น ห้ามใช้กระเป๋าที่มีเงินจริงเด็ดขาด
PRIVATE_KEY=your_testnet_private_key_here

# RPC Endpoints (ใช้ค่า default หรือจาก Alchemy / Infura / QuickNode)
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org
